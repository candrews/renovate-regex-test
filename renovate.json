{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommitTypeAll(chore)"
    ],
    "pinDigests": true,
    "gitLabIgnoreApprovals": true,
    "gitlabci": {
        "fileMatch": [
            ".*\\.yml$"
        ]
    },
    "packageRules": [
        {
            "matchFileNames": [
                "stuff/**"
            ],
            "semanticCommitType": "fix"
        },
        {
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "automerge": true
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": [
                "(^|/)Dockerfile$"
            ],
            "matchStrings": [
                "ARG VAULT_VERSION=(?<currentValue>.+?)\\n"
            ],
            "depNameTemplate": "hashicorp/vault",
            "datasourceTemplate": "github-releases"
        },
        {
            "customType": "regex",
            "fileMatch": [
                "(^|/)Dockerfile$"
            ],
            "matchStrings": [
                "ARG CHECKOV_VERSION=(?<currentValue>.+?)\\n"
            ],
            "datasourceTemplate": "pypi",
            "depNameTemplate": "checkov"
        }
    ]
}
